---
import HeaderBrun from '../../components/Header-brun.astro';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() {

const endpoint = "https://bphedaswhofuabrmqoun.supabase.co/rest/v1/events?select=*&order=dato.desc";
const apikey = "sb_publishable_kw8uTcW5ED7N2040ycEp2w_1a0cwbkV";

const options = {
  headers: { apikey: apikey },

}
  const response = await fetch(endpoint, options);
  const data: any[] = await response.json();

  return data.map((event) => {
    return {
      params: { id: event.id.toString() },
      props: { event },
    };
  });
}

//  toString laver tal om til tekst

const { id } = Astro.params;
const { event } = Astro.props;
---

<Layout>
<HeaderBrun/>

  <section class="detail-hero">

    <img
    src=`https://bphedaswhofuabrmqoun.supabase.co/storage/v1/object/public/event-billeder/${event.id}/card.webp`
    alt="eventbillede"
    />
    
    <div class="hero-text">

      <h1>{event.eventnavn}</h1>
     <p>{new Date(event.dato).toLocaleDateString("de-DE", {
    day: "2-digit",
    month: "2-digit",
  })}</p>
      <p>{event.adresse}</p>
    </div>
    
    
  </section>
  
  
  <section class="description-section">
    
    <div>
      
      <h2>Description</h2>
      <p ></p>
      
      <p class="beskrivelsestekst"> {event.beskrivelse}</p>
        </div>
        
        
        <div class="accordion">
            
            <details>
                <summary>Event Details</summary>
<p>{event.details}</p>            </details>
            
            <details>
                <summary>Agenda</summary>
                <p>{event.Agenda}</p>
            </details>
            <details>
                <summary>A few things to know</summary>
                <p>{event.know}</p>
            </details>
            <details>
                <summary>Location</summary>
                <p>{event.adresse}</p>

            </details>
        </div>
        
    </section>
        
         
</Layout>

<style>
  .beskrivelsestekst,
  .accordion {
    white-space: pre-line;
  }

/* STYLING FOR HERO */
.detail-hero {
  display: grid;
}

.detail-hero > img {
  grid-area: 1/1;
  width: 100%;
  height: 100%;

}
.hero-text {
  background-color: #fbf8edeb;
  grid-area: 1/1;
  align-self: end;
  margin: 1rem;
  padding: 1rem;
  border-radius: 10px;
}

  @media (min-width: 600px) {
    .detail-hero {
     display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    }

    .detail-hero > img {
  grid-column: 1/6;
  width: 100%;
  height: 100%;
max-height: 300px;
object-fit: cover;
}
.hero-text {
  background-color: #fbf8edeb;
  grid-column: 1/4;
  align-self: end;
  margin: 1rem;
  padding: 1rem;
  border-radius: 10px;
}

  }


  /* BESKRIVELSE OG ACCORDION SECTION */

    .beskrivelsestekst {
    max-width: 65ch;
  }

  @media (min-width: 600px) {
  .description-section 
  {display: grid;
  grid-template-columns: 1fr 1fr;
gap: 2rem;
margin-top: 4rem;
margin-bottom: 2rem;} }


  /* -------- STYLING FOR ACCORDION ---------*/ 
  .accordion {
    max-width: 600px;
  }
  .accordion details {
  border-top: 1px solid #2C0F12;
}

.accordion details:last-child {
  border-bottom: 1px solid #2C0F12;
}

.accordion summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  cursor: pointer;
  list-style: none;
  font-size: 18px;
  font-weight: 400;
  color: #2C0F12;
}

/* Hide default arrow */
.accordion summary::-webkit-details-marker {
  display: none;
}

/* Custom arrow */
.accordion summary::after {
  content: "v";
  font-size: 24px;
  line-height: 1;
  transition: transform 0.2s ease;
}

/* Rotate arrow when open */
.accordion details[open] summary::after {
  transform: rotate(90deg);
}

/* Accordion content */
.accordion details p {
  margin: 0;
  padding: 0 0 20px;
  font-size: 14px;
  line-height: 1.6;
  color: #321919;
}

</style>