---
import Layout from "../layouts/Layout.astro";
import GulKnap from "../components/GulKnap.astro";
import BrunKnap from "../components/BrunKnap.astro";
import Footer from "../components/Footer.astro";

const events = [
  {
    title: "TOKYO MEETUP",
    date: "DEC 02",
    location: "Copenhagen",
    image: "/images/tokyo-meetup.webp",
    href: "/events",
  },
  {
    title: "AI SKILL-SHARING",
    date: "DEC 18",
    location: "Copenhagen",
    image: "/images/ai-skillsharing.webp",
    href: "/events",
  },
];

const collaborators = [
  { name: "Bernies.Space", logo: "/logo1.svg" },
  { name: "Louis", logo: "/logo2.svg" },
  { name: "DEPT", logo: "/logo3.svg" },
  { name: "Samarbejdspartner", logo: "/logo4.svg" },
  { name: "R / m", logo: "/logo5.svg" },
];
---

<Layout title="Home | KindDesign CPH" header="gul">

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <h1 id="hero-title">
        <img
          src="/bepartofsomethingcreative.svg"
          alt="Be part of something creative"
          width="968"
          height="147"
        />
      </h1>

      <div class="hero-buttons">
        <GulKnap text="Explore Events" href="/events" />
        <GulKnap text="About KindDesign" href="/about" />
      </div>
    </div>

    <a
      class="scroll-down"
      href="#community-intro"
      aria-label="Discover our community"
    >
      ↓
    </a>
  </section>

  <!-- INTRO -->
  <section
    class="intro container"
    id="community-intro"
    aria-labelledby="intro-title"
  >
    <h2 id="intro-title">A Copenhagen community</h2>

    <p>
      For designers and creative minds to meet,<br />
      share ideas and find their people
    </p>
  </section>

  <!-- UPCOMING EVENTS -->
  <section
    class="events-section container"
    aria-labelledby="events-title"
  >
    <div class="section-heading">
      <h2 id="events-title">Upcoming events</h2>
      <a class="text-link" href="/events">See all →</a>
    </div>

    <div class="event-grid">
      {
        events.map((event) => (
          <article
            class="event-card"
            style={{ backgroundImage: `url("${event.image}")` }}
          >
            <h3>{event.title}</h3>

            <div class="event-info">
              <div>
                <p class="event-date">{event.date}</p>
                <p class="event-location">{event.location}</p>
              </div>

              <a class="ticket-link" href={event.href}>
                Get tickets
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- COMMUNITY -->
  <section
    class="community"
    aria-labelledby="community-title"
  >
    <div class="community-panel">
      <img
        class="decoration"
        src="/star.svg"
        alt=""
        width="63"
        height="63"
      />

      <h2 id="community-title" class="community-title">
  <span>The</span>

  <img
    src="/kinddesign.svg"
    alt="KindDesign"
    width="264"
    height="41"
    loading="lazy"
  />

  <span>Community</span>
</h2>

      <p class="subtitle">
        An inclusive, authentic and connected community
      </p>

      <p>
        KindDesign CPH brings creative people together to share ideas,
        learn from each other and make new connections. Through meetups,
        talks and hands-on events in Copenhagen, we create space for
        inspiration and conversations that go beyond “So, what do you do?”
      </p>

      <p>
        Come with a friend or show up on your own. There’s room for fresh
        perspectives, curious minds and whatever you’re working on.
        We’d love to meet you.
      </p>

      <BrunKnap text="Read more" href="/about" />
    </div>
  </section>

  <!-- ALL KINDS OF VOICES -->
  <section
    class="voices-section container"
    aria-labelledby="voices-title"
  >
    <div class="centered-heading">
      <h2 id="voices-title">All kinds of voices</h2>
      <p class="subtitle">We’ll let our people do the talking.</p>
    </div>

    <div class="voices-artwork">
  <!-- Stjernen øverst til højre -->
  <img
    class="voices-star"
    src="/star.svg"
    alt=""
    width="63"
    height="63"
    loading="lazy"
  />

  <!-- De fire polaroidkort -->
  <img
    class="voices-image"
    src="/polo.svg"
    alt="Udtalelser fra Sofie Nielsen, Mads Holm, Emma Rasmussen og Karla Møller"
    width="1200"
    height="600"
    loading="lazy"
  />


  <img
    class="polaroid-star star-left"
    src="/star.svg"
    alt=""
    width="63"
    height="63"
    loading="lazy"
  />

 
  <img
    class="polaroid-star star-top"
    src="/star.svg"
    alt=""
    width="63"
    height="63"
    loading="lazy"
  />

  <img
    class="polaroid-star star-bottom"
    src="/star.svg"
    alt=""
    width="63"
    height="63"
    loading="lazy"
  />
</div>
  </section>

  <!-- COLLABORATORS -->
  <section
    class="collaborators-section"
    aria-labelledby="collaborators-title"
  >
    <div class="container">
      <div class="centered-heading">
        <h2 id="collaborators-title">Collaborators</h2>
        <p class="subtitle">
          Meet the people and organisations making our events possible.
        </p>
      </div>

      <ul class="collaborator-list">
        {
          collaborators.map((collaborator) => (
            <li>
              <img
                src={collaborator.logo}
                alt={collaborator.name}
                width="160"
                height="100"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <div class="collaborator-button">
        <BrunKnap text="See more" href="/collaborations" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* FÆLLES */

  .container {
    width: min(1200px, calc(100% - 64px));
    margin-inline: auto;
  }

  h2 {
    font-size: clamp(22px, 2.6vw, 36px);
    text-transform: uppercase;
  }

  .subtitle {
    font-style: italic;
  }

  .centered-heading {
    text-align: center;
  }

  .centered-heading h2 {
    margin-bottom: 8px;
  }

  .centered-heading p {
    font-size: 16px;
  }

  /* HERO */

  .hero {
    position: relative;
    isolation: isolate;
    min-height: 90svh;
    display: grid;
    place-items: center;
    padding: 160px 32px 100px;
    background-color: #4b5143;
    background-image: url("/hero.svg");
    background-size: cover;
    background-position: center;
    text-align: center;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 15%);
  }

  .hero-content {
    width: min(1100px, 100%);
  }

  .hero h1 {
    margin: 0 0 40px;
  }

  .hero h1 img {
    display: block;
    width: min(968px, 100%);
    height: auto;
    margin-inline: auto;
  }

  .hero-buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 32px;
}

.hero-buttons :global(.cta) {
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 16px;
}

  .scroll-down {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    color: #fbfeb4;
    font-size: 36px;
    text-decoration: none;
  }

  /* INTRO */

  .intro {
    padding-block: 90px;
    text-align: center;
    scroll-margin-top: 24px;
  }

  .intro p {
    margin-bottom: 0;
    font-size: 16px;
    font-style: italic;
    text-transform: uppercase;
  }

  /* EVENTS */

  .events-section {
    padding-bottom: 110px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 24px;
  }

  .section-heading h2 {
    margin: 0;
  }

  .text-link {
    flex-shrink: 0;
    color: #2c0f12;
    font-size: 16px;
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .event-card {
    position: relative;
    isolation: isolate;
    min-height: 310px;
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 16px;
    padding: 24px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #5b3931;
    background-size: cover;
    background-position: center;
  }

  .event-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 15%);
  }

  .event-card h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .event-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: 24px 16px;
    border-radius: 8px;
    background: rgb(246 243 232 / 85%);
  }

  .event-date {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 700;
  }

  .event-location {
    margin: 0;
    font-size: 14px;
  }

  .ticket-link {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 6px;
    background: #fbfeb4;
    color: #2c0f12;
    font-size: 14px;
    text-decoration: none;
  }

  .ticket-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* COMMUNITY */

  .community {
    min-height: 650px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 60px 32px;
    background-color: #5b6350;
    background-image: url("/gruppebillede.svg");
    background-size: cover;
    background-position: center;
  }

  .community-panel {
    position: relative;
    width: min(560px, 52%);
    padding: 40px;
    background: rgb(246 243 232 / 88%);
  }

  .community-panel h2 {
    margin: 0 0 12px;
  }

  .community-panel h2 img {
    display: block;
    width: 40%;
    height: auto;
  }

  .community-panel p {
    font-size: 16px;
  }

  .community-panel .subtitle {
    margin-bottom: 28px;
  }

  .decoration {
    position: absolute;
    top: -24px;
    left: -22px;
    width: 48px;
    height: auto;
  }

  .community-panel .community-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  font-size: clamp(20px, 2vw, 32px);
  text-transform: uppercase;
}

.community-panel .community-title img {
  width: 180px;
  max-width: 100%;
  height: auto;
}

.community-panel :global(.cta) {
  padding: 8px 16px;
  margin-top: 16px;
  border-radius: 6px;
  font-size: 14px;
}

/* VOICES */

.voices-section {
  padding-block: 100px 120px;
}

.voices-section .centered-heading {
  text-align: center;
}

.voices-section .centered-heading h2 {
  margin: 0 0 8px;
}

.voices-section .subtitle {
  margin: 0;
  font-size: 16px;
  font-style: italic;
}

.voices-artwork {
  position: relative;
  margin-top: 32px;
}

.voices-image {
  display: block;
  width: 100%;
  height: auto;
}

/* Fælles styling til alle fire stjerner */
.voices-artwork .voices-star,
.voices-artwork .polaroid-star {
  position: absolute;
  z-index: 1;
  height: auto;
  pointer-events: none;
}

/* Øverst til højre */
.voices-artwork .voices-star {
  top: 110;
  right: 1%;
  left: auto;
  width: clamp(40px, 2.3vw, 28px);
}

/* Ved Sofie */
.voices-artwork .star-left {
  top: 35%;
  left: 1%;
    width: clamp(40px, 2.3vw, 28px);
  transform: rotate(-15deg);
}

/* Ved Mads */
.voices-artwork .star-top {
  top: 11%;
  left: 39%;
    width: clamp(40px, 2.3vw, 28px);
  transform: rotate(12deg);
}

/* Ved Emma */
.voices-artwork .star-bottom {
  bottom: 11%;
  left: 65%;
    width: clamp(40px, 2.3vw, 28px);
  transform: rotate(-10deg);
}

  /* COLLABORATORS */

  .collaborators-section {
    padding-block: 64px;
    background: rgb(251 254 180 / 55%);
  }

  .collaborator-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center;
    gap: 40px;
    margin: 40px 0;
    padding: 0;
    list-style: none;
  }

  .collaborator-list img {
    width: 100%;
    height: 100px;
    object-fit: contain;
  }

 .collaborator-button {
  display: flex;
  justify-content: center;
}

.collaborator-button :global(.cta) {
  padding: 12px 20px;
  border-radius: 6px;
  font-size: 16px;
}


  /* MOBIL */

  @media (max-width: 700px) {
    .container {
      width: calc(100% - 40px);
    }

    .hero {
      min-height: 85svh;
      padding: 150px 20px 90px;
    }

    .hero h1 {
      margin-bottom: 28px;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .intro {
      padding-block: 56px;
    }

    .intro p {
      font-size: 13px;
    }

    .events-section {
      padding-bottom: 64px;
    }

    .section-heading {
      gap: 12px;
    }

    .text-link {
      font-size: 13px;
    }

    .event-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .event-card {
      min-height: 250px;
    }

    .event-card h3 {
      font-size: 28px;
    }

    .community {
      min-height: 720px;
      align-items: flex-end;
      padding: 220px 20px 32px;
      background-position: 35% center;
    }

    .community-panel {
      width: 100%;
      padding: 28px 24px;
    }

    .community-panel p {
      font-size: 14px;
    }

    .voices-section {
    padding-block: 56px 64px;
  }

  .voices-section .subtitle {
    font-size: 14px;
  }

  .voices-artwork {
    margin-top: 24px;
  }

    .collaborators-section {
      padding-block: 48px;
    }

    .collaborator-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .collaborator-list img {
      height: 80px;
    }
  }
</style>