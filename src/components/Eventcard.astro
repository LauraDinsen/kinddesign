---
const { event } = Astro.props;
---

<article
class="card" data-kategori={event.kategori} 
style={`background-image: linear-gradient(rgb(44 15 18 / 50%), rgb(44 15 18 / 50%)),
url("https://bphedaswhofuabrmqoun.supabase.co/storage/v1/object/public/event-billeder/${event.id}/card.webp")`}>
<h3>{event.eventnavn}</h3>
<div>
  <p>{new Date(event.dato).toLocaleDateString("de-DE", {
    day: "2-digit",
    month: "2-digit",
  })}</p>
  <p>{event.lokation}</p>
  <a href=`/details/${event.id}`>Read more</a>
</div>
</article>

<style>

.hide {
  display: none;

}

  article {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 100px;
    padding: 1rem;
    border-radius: 10px;
    background-color: #3f0909e2;
    background-size: cover;
    background-position: center;
  }

  h3 {
    color: #fffdf3;
    text-transform: uppercase;
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }

  div {
    padding: 1rem;
    background-color: #f6f3e8e8;
    border-radius: 8px;
  }

 

  p {
    margin: 0 0 1rem 0;
  }

  a {
    text-decoration: none;
    background-color: #fdfdb5ba;
    color: #3f0909e2;
    border-radius: 5px;
    padding: 4px 8px;

  }

</style>