---
import HeaderGul from "../components/Header-gul.astro";
import HeaderBrun from "../components/Header-brun.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  header?: "gul" | "brun";
}

const {
  title,
  description = "Discover KindDesign CPH.",
  header = "brun",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

 <body>
  {header === "gul" ? <HeaderGul /> : <HeaderBrun />}

  <main>
    <slot />
  </main>
    <Footer />

</body>

</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

html,

body {
  margin: 0;
  padding: 0;
}

  body {
    background-color: #f6f3e8;
    color: #2c0f12;
    font-family: Arial, sans-serif;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  h2 {
  font-size: clamp(20px, 3.5vw, 48px);
  margin: 0 0 16px;
}

h3 {
  font-size: clamp(16px, 2.5vw, 36px);
  margin: 0 0 12px;
}

p {
  margin: 0 0 16px;
}

@media (max-width: 700px) {
  body {
    font-size: 14px;
  }
}
</style>
